{
  "url": "https://www.buddy4study.com/sitemap1.xml",
  "kind": "crawl",
  "discover": "sitemap",
  "pathPrefix": "/scholarship/",
  "pathPattern": "/scholarship/*",
  "newestPages": 300,
  "nextDataPath": "props.pageProps.scholarship.scholarship",
  "mapping": {
    "title": "scholarshipMultilinguals.0.title",
    "organization": "scholarshipProviders.0.providerName",
    "description": "scholarshipMultilinguals.0.applicableFor",
    "attr.deadline": "deadlineDate",
    "attr.award": "scholarshipMultilinguals.0.purposeAward",
    "attr.officialUrl": "scholarshipWebsiteLinks.0.url",
    "attr.type": "oppurtunityType"
  },
  "organizationOptional": true,
  "dropPastAfter": "deadline",
  "modules": ["scholarships", "internships"],
  "moduleFilter": {
    "internships": {
      "field": "attr.type",
      "match": "^internship$"
    },
    "scholarships": {
      "field": "attr.type",
      "match": "^internship$",
      "negate": true
    }
  },
  "geography": ["IN"],
  "permission": "terms_permit",
  "permissionEvidence": "terms pending: confirm Buddy4Study allows reuse of its listings (owner decision 'buddy4study-crawl' in Setup to-do). Checked 2026-11-05: robots.txt disallows only /media-url/ and /UID/ and lists /sitemap.xml; sitemap1.xml holds about 1,380 /scholarship/ pages, oldest first, so only the newest 300 are read. Each page's Next.js data holds title, provider, type, deadline, eligibility and award; its type sends internships to Internships, the rest to Scholarships. No open API or feed.",
  "termsReviewed": true,
  "robotsReviewed": true,
  "redistributionAllowed": true,
  "externalRedistributionAllowed": false,
  "attribution": "Buddy4Study",
  "retentionHours": 168,
  "minIntervalMinutes": 360,
  "maxPagesPerRun": 30,
  "crawlDelayMs": 2000
}
