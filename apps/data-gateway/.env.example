# Set fresh 32+ character random values; never commit real credentials.
GATEWAY_ADMIN_TOKEN=
GATEWAY_CURSOR_SECRET=
GATEWAY_DATA_FILE=./.data/gateway.json
GATEWAY_PORT=8790
GATEWAY_COLLECTORS_ENABLED=0
GATEWAY_ALLOW_EXTERNAL_CONSUMERS=0
# Optional for a reverse proxy, which must terminate TLS.
GATEWAY_HOST=127.0.0.1
