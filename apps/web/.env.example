# --- Supabase (auth + persistence). Leave unset for local-only mode: no sign-in, seeded demo data,
#     localStorage + in-memory server state.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: used by the browser for Supabase Auth (sign-in / sign-up) and by the server to verify sessions.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service role key from Supabase → Project Settings → API keys. Server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# --- Encryption key for BYOK provider secrets (32+ random chars). Required in production.
#     e.g. `openssl rand -base64 48`
SECRET_ENCRYPTION_KEY=

# --- WonderJobs AI (platform-billed model behind "WonderJobs AI"). Optional: without it, drafting uses
#     deterministic templates and the AI settings page says so. Defaults to Anthropic (model claude-sonnet-5);
#     set WONDERJOBS_AI_PROVIDER to openai or gemini to run the platform key on that vendor instead — the
#     API key and default model switch with it (gpt-5-mini / gemini-2.5-flash), or override WONDERJOBS_AI_MODEL.
WONDERJOBS_AI_PROVIDER=anthropic
WONDERJOBS_AI_KEY=
WONDERJOBS_AI_MODEL=claude-sonnet-5
# --- Cloud browser (apps/browser-worker): "Fill for me" without the Chrome extension, on phones too.
#     Leave unset and the page offers Guide me instead. CLOUD_BROWSER_SECRET must match the worker's
#     (32+ random chars, e.g. `openssl rand -base64 48`); see apps/browser-worker/README.md to deploy it.
CLOUD_BROWSER_URL=
CLOUD_BROWSER_SECRET=

# --- Job sources. Everything else is key-less. Adzuna (India-wide postings) needs a free app id/key:
#     https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Landing-page "Contact us" notifications. Comma-separated list of addresses that get a copy of
#     every message (messages are always stored in wonderjobs.contact_messages regardless of this).
CONTACT_NOTIFY_EMAILS=
# Sent through your own mailbox over SMTP. Without SMTP_HOST, SMTP_USER and SMTP_PASS, notifications are
# logged server-side instead of emailed (same honest-fallback pattern as WONDERJOBS_AI_KEY).
# GoDaddy email (MX smtp.secureserver.net): host smtpout.secureserver.net, port 465, the full address as user.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "WonderJobs <SMTP_USER>"; mailbox providers only send as the signed-in address.
CONTACT_FROM_EMAIL=

# --- Billing: Pro subscriptions through Razorpay (India: UPI AutoPay, cards, net banking) and/or Stripe
#     (international cards, Apple Pay, Google Pay). Each provider turns on only when ALL its variables
#     are set; otherwise the Plan card says "Needs setup". Prices are never configured here — create the
#     recurring price/plan in the provider's dashboard and paste its id; the app reads amount, currency
#     and interval from the provider. Card / bank details are entered on the provider's hosted page only.
#     Webhook endpoints to register in each dashboard:
#       https://<your-domain>/api/billing/webhooks/stripe    (events: checkout.session.completed,
#         customer.subscription.created/updated/deleted/paused/resumed, invoice.paid, invoice.payment_failed)
#       https://<your-domain>/api/billing/webhooks/razorpay  (events: subscription.*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
# Optional. Billing cycles per Razorpay subscription (Razorpay requires a fixed count). Default 120.
RAZORPAY_TOTAL_COUNT=
# Read-only auditor access to the billing ledger (GET /api/admin/billing-ledger, ?format=csv).
# Give it to whoever reviews financial records — it can verify and export, never write. 32+ random chars.
BILLING_AUDITOR_TOKEN=

# --- Privacy (GDPR / DPDP). Published on /privacy and in the app's "Your data" card. Without them the
#     privacy page directs requests to the contact form (topic "Privacy request"), which is stored and audited.
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Plans (Free / Pro / Max). Pro uses STRIPE_PRICE_ID / RAZORPAY_PLAN_ID above; Max needs its own price / plan at the provider.
# Limits, prices and names are edited at /app/operator/plans by the accounts in JOBSLAKE_ADMIN_EMAILS — no deploy needed.
STRIPE_PRICE_ID_MAX=
RAZORPAY_PLAN_ID_MAX=
