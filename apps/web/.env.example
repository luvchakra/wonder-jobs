# WonderWorks environment variables. Checked against the code on 2026-11-06 (docs/changes/WJ-772.md).
# Most keys are entered in the admin now, not here: see "In the admin" at the end.

# =============================================================== Must set: the app doesn't work without these
# Supabase: database and sign-in. Leave all three unset for local-only mode (no sign-in, in-memory state).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts everything stored in the admin (source keys, Razorpay keys, users' own AI keys, résumé copies).
# 32+ random chars, e.g. `openssl rand -base64 48`. Required in production. MOVING DEPLOYMENTS: copy the exact
# same value, or everything already encrypted becomes unreadable.
SECRET_ENCRYPTION_KEY=
# Protects the scheduled jobs (Vercel crons and the GitHub Actions collection). Must equal the CRON_SECRET
# secret in GitHub Actions. 32+ random chars.
CRON_SECRET=
# Comma-separated emails that may open Admin.
JOBSLAKE_ADMIN_EMAILS=

# =============================================================== Needed for the product as it runs today
# The built-in source gateway (collection of outside sources). Without both it answers 503 and nothing is collected.
GATEWAY_ADMIN_TOKEN=
GATEWAY_CURSOR_SECRET=
# Lets each module read the gateway's listings. The URL is the site's own address.
WORKSLAKE_GATEWAY_ENABLED=1
WORKSLAKE_GATEWAY_URL=https://jobs.wonderapps.biz
WORKSLAKE_GATEWAY_API_KEY=
# Email (SMTP_*, CONTACT_FROM_EMAIL, CONTACT_NOTIFY_EMAILS): Admin → Keys → Email, with a "Send a test email" button.
# Not needed here any more (owner, 2026-11-06); a value set here still wins over the admin's.
# Links and the logo in emails. Falls back to the deployment's production URL, which on a fresh Vercel project is
# the .vercel.app address until the domain is attached, so set it.
NEXT_PUBLIC_SITE_URL=https://jobs.wonderapps.biz

# =============================================================== Optional
# WonderWorks AI (WONDERJOBS_AI_KEY / _PROVIDER / _MODEL) and push notifications (VAPID_*): Admin → Keys → WonderWorks AI
# and Push notifications ("Generate a key pair"). Not needed here; a value set here still wins over the admin's.
# Shown on /privacy. Without them the page points at the contact form.
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_PRIVACY_EMAIL=
# Read-only auditor access to the billing ledger (GET /api/admin/billing-ledger). 32+ random chars.
BILLING_AUDITOR_TOKEN=
# Stripe, only if it's ever switched on (it isn't offered in the admin). All three, or nothing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_MAX=
# WorksLake API pay-as-you-go on Stripe (a metered price); off without it.
STRIPE_API_PRICE_ID=
# WorksLake's MCP endpoint; off unless both are set.
JOBSLAKE_MCP_ENABLED=
JOBSLAKE_MCP_TOKEN=
# The Chrome Web Store listing, once published; until then the page offers the direct download.
NEXT_PUBLIC_EXTENSION_STORE_URL=
# Tuning, with sensible defaults: THEIRSTACK_MONTHLY_CREDITS (1500), PAID_SOURCES_TOPUP_BELOW (15), JSEARCH_DAILY_MAX (150),
# CRON_INTERVAL_MINUTES (1440), RAZORPAY_TOTAL_COUNT (120), JOBSLAKE_API_FREE_SEARCHES / JOBSLAKE_API_MAX_MONTHLY / JOBSLAKE_API_SOURCE_IDS.

# =============================================================== GitHub Actions: the collection runner (not Vercel)
# The 3-hourly collection and Find refresh run on the GitHub Actions runner (.github/workflows/gateway-collect.yml), so
# add these as repository secrets (GitHub → Settings → Secrets and variables → Actions): SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, SECRET_ENCRYPTION_KEY (the exact value above), GATEWAY_ADMIN_TOKEN, GATEWAY_CURSOR_SECRET,
# WORKSLAKE_GATEWAY_API_KEY; and the variable SITE_URL. (Email and source keys come from the admin's store.)
# For Admin → Sources → Import's buttons to start that runner: the GitHub token on Admin → Keys → Collection runner.
# Optional: another repository or branch for the dispatch (defaults: luvchakra/wonder-jobs, main).
GITHUB_DISPATCH_REPO=
GITHUB_DISPATCH_REF=

# =============================================================== In the admin: do NOT set these here
# A variable set here wins over the admin's value, so leave these out of the deployment.
# - Source keys: Admin → Keys (ADZUNA_*, USAJOBS_*, JOOBLE_API_KEY, THEMUSE_API_KEY, JSEARCH_API_KEY, THEIRSTACK_API_KEYS,
#   TICKETMASTER_API_KEY, OPENAGENDA_API_KEY, THESPORTSDB_API_KEY, KAGGLE_API_TOKEN, CLIST_*, RELIEFWEB_APPNAME,
#   FIND_APPRENTICESHIP_API_KEY, SIMPLER_GRANTS_API_KEY, FLIPKART_*, EBAY_*, NAV_PAM_STILLING_FEED_TOKEN).
# - Razorpay: Admin → Billing → Payments (RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET).
#   RAZORPAY_PLAN_ID / RAZORPAY_PLAN_ID_MAX are no longer needed: Admin → Billing → Prices creates the plans.
# - Module databases: Admin → Databases (WORKSLAKE_DATA_DB_URL, WORKSLAKE_DATA_DB_KEY).
# - Email, WonderWorks AI, push keys and the collection runner's GitHub token: Admin → Keys (SMTP_*, CONTACT_FROM_EMAIL,
#   CONTACT_NOTIFY_EMAILS, WONDERJOBS_AI_*, VAPID_*, GITHUB_DISPATCH_TOKEN). Each has "Copy from the deployment".

# =============================================================== Leave out
# Old aliases (WONDER_SECRET_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY), the retired cloud
# browser (CLOUD_BROWSER_*, FLY_API_TOKEN), flags that default on (JOBSLAKE_SEARCH_ENABLED, JOBSLAKE_CACHE_ENABLED,
# JOBSLAKE_ADMIN_ENABLED), and local/test-only settings (JOBSLAKE_LOCAL_ADMIN, WJ_E2E_*, PLAYWRIGHT_*).
