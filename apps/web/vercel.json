{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build && node scripts/fix-output-dir.mjs",
  "outputDirectory": ".next",
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "git": { "deploymentEnabled": { "*/**": false } },
  "regions": ["bom1"],
  "crons": [
    { "path": "/api/cron/scheduled-runs", "schedule": "0 2 * * *" },
    { "path": "/api/cron/jobslake-companies", "schedule": "30 1 * * *" },
    { "path": "/api/cron/jobslake-ratings", "schedule": "50 1 * * *" },
    { "path": "/api/cron/application-reminders", "schedule": "30 3 * * *" }
  ]
}
