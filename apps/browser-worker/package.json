{
  "name": "@wonder/browser-worker",
  "version": "0.1.0",
  "private": true,
  "description": "WonderJobs cloud browser: opens an employer's application page in an isolated browser, streams it to the candidate, fills what their own profile can fill — and never submits.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
